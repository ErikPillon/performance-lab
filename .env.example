# ---- Postgres ----
POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=performance_lab
DATABASE_URL=postgres://lab:change-me-locally@localhost:5433/performance_lab

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6380

# ---- MinIO / S3 ----
# Swap these four for real S3 / Cloudflare R2 credentials and the code is unchanged.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=lab-access-key
S3_SECRET_KEY=change-me-locally
S3_BUCKET=performance-lab
S3_FORCE_PATH_STYLE=true

# ---- Services ----
ANALYTICS_URL=http://localhost:8001
INGEST_PORT=8002
API_PORT=8003

# ---- Dashboard ----
VITE_API_URL=http://localhost:8003
# Basemap tiles for route maps. The default public OpenStreetMap endpoint sees
# which areas you view; point this at your own tile server to keep that local.
# VITE_MAP_TILES=http://192.168.40.100:8080/tile/{z}/{x}/{y}.png

# ---- Ingest ----
# Max accepted upload size in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400

# ---- Auth ----
# Signs session cookies and tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it logs everyone out.
BETTER_AUTH_SECRET=generate-me
# Where the browser reaches the app. Used for cookie scope and redirect checks.
# Must match SITE_ADDRESS below (including port). An https value here also turns
# on Secure cookies, so the session cookie stops travelling in clear.
AUTH_BASE_URL=https://localhost
# Set false once your account exists to stop anyone else registering. An account
# with no athlete and no grants can see nothing either way.
AUTH_ALLOW_SIGNUP=true

# ---- TLS / edge ----
# How the browser reaches the app. An IP or *.localhost address gets a
# certificate from Caddy's own internal CA and needs nothing external; a real
# hostname triggers ACME and needs the token below.
#   local:  https://localhost
#   LAN:    https://192.168.40.100
#   public: https://lab.yourdomain.com
SITE_ADDRESS=https://localhost
# Standard ports, so Caddy's automatic http->https redirect lands somewhere
# that exists. On a non-standard port the redirect drops it and sends the
# browser to :443. Change these only if something else already owns them.
HTTP_PORT=80
HTTPS_PORT=443

# Only needed for a publicly trusted certificate. A server behind NAT cannot
# answer an HTTP-01 challenge, so Caddy proves domain control over DNS instead.
# Create at https://dash.cloudflare.com/profile/api-tokens with the template
# "Edit zone DNS", scoped to the one zone. Leave empty to use the internal CA.
CLOUDFLARE_API_TOKEN=
ACME_EMAIL=
# Uncomment while getting a deployment right, to avoid burning rate limits:
# ACME_CA_DIRECTIVE=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# ---- Deploy (server only) ----
# Which published image the server runs. `latest` tracks main; a `sha-<commit>`
# value pins one build, which is what you want while investigating something.
# scripts/deploy.sh manages this for you and records the previous value so
# `./scripts/deploy.sh --rollback` has somewhere to go.
IMAGE_TAG=latest

# ---- Backups (server only) ----
# Where snapshots land, and how many daily ones to keep.
BACKUP_DIR=/opt/performance-lab/backups
BACKUP_KEEP=14
# A second machine to replicate snapshots to, as rsync target user@host:/path.
# Leave empty to keep snapshots local only — which protects against deleting
# the wrong row, and against nothing else. The raw FIT objects exist in exactly
# one place until this is set.
BACKUP_REMOTE=

# ---- Third-party connections ----
# Encrypts OAuth tokens at rest. A Strava refresh token is a long-lived
# credential to your whole training history, and it ends up in every backup,
# dump and replica. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Its own secret rather than BETTER_AUTH_SECRET: rotating the auth secret only
# logs everyone out, and should stay that cheap.
TOKEN_ENCRYPTION_KEY=

# Strava. Create an application at https://www.strava.com/settings/api and set
# its "Authorization Callback Domain" to the host in AUTH_BASE_URL (just the
# host — no scheme, no path). Leave these empty and the connector stays hidden
# in the UI rather than half-working.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
