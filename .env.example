# ---- Postgres ----
POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=performance_lab
DATABASE_URL=postgres://lab:change-me-locally@localhost:5433/performance_lab

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6380

# ---- MinIO / S3 ----
# Swap these four for real S3 / Cloudflare R2 credentials and the code is unchanged.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=lab-access-key
S3_SECRET_KEY=change-me-locally
S3_BUCKET=performance-lab
S3_FORCE_PATH_STYLE=true

# ---- Services ----
ANALYTICS_URL=http://localhost:8001
INGEST_PORT=8002
API_PORT=8003

# ---- Dashboard ----
VITE_API_URL=http://localhost:8003
# Basemap tiles for route maps. The default public OpenStreetMap endpoint sees
# which areas you view; point this at your own tile server to keep that local.
# VITE_MAP_TILES=http://192.168.40.100:8080/tile/{z}/{x}/{y}.png

# ---- Ingest ----
# Max accepted upload size in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400
